CONFIG ?= Debug

ifeq ($(CONFIG),Debug)
    OPTFLAGS = -O0
else ifeq ($(CONFIG),Release)
    OPTFLAGS = -O2 -D_RELEASE
else
    $(error Unknown CONFIG '$(CONFIG)', use Debug or Release)
endif

BUILD = build/$(CONFIG)

CXX = clang
CXXFLAGS = -Wall -std=c++23 -target x86_64-windows -nostdlib -ffreestanding -fno-asynchronous-unwind-tables -mno-stack-arg-probe -mgeneral-regs-only -MMD -MP $(OPTFLAGS)
LD = lld-link
LFLAGS = -subsystem:efi_application -nodefaultlib -entry:EfiMain -implib:$(BUILD)/boot.lib

OUT = ../bin/$(CONFIG)/vdisk/EFI/BOOT/BOOTX64.EFI

all: $(OUT)

$(OUT): $(BUILD)/boot.o
	mkdir -p $(dir $@)
	$(LD) $(LFLAGS) $< -out:$@

# -MJ is for compile_commands
$(BUILD)/boot.o $(BUILD)/boot.o.json &: entry.cc
	mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MJ $(BUILD)/boot.o.json -c $< -o $(BUILD)/boot.o

compdb: $(BUILD)/boot.o.json

# Header dependencies generated by -MMD
-include $(wildcard $(BUILD)/boot.d)

.SILENT:
.PHONY: all clean compdb
clean:
	rm -rf build
	find -type f \( -name "*.o" -o -name "*.d" -o -name "*.lib" -o -name "*.EFI" \) -delete
