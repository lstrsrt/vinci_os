CONFIG ?= Debug

ifeq ($(CONFIG),Debug)
    OPTFLAGS = -O0
else ifeq ($(CONFIG),Release)
    OPTFLAGS = -O2 -D_RELEASE
else
    $(error Unknown CONFIG '$(CONFIG)', use Debug or Release)
endif

BUILD = build/$(CONFIG)

CXX = clang
CXXFLAGS = -std=c++23 -Wall -Wno-unused-function -Wno-deprecated-volatile -target x86_64-windows -nostdlib \
    -ffreestanding -mno-stack-arg-probe -mgeneral-regs-only -fno-asynchronous-unwind-tables -mno-red-zone \
    -mno-80387 -mno-mmx -mno-sse -mno-sse2 -fno-exceptions -fno-rtti -fno-omit-frame-pointer -mcmodel=kernel \
    -MMD -MP $(OPTFLAGS) -I $(INCLUDE)

AS = nasm
ASFLAGS = -f win64

LD = lld-link
LFLAGS = -subsystem:native -section:"INIT,RED" -section:".CRT,RED" -section:"PROTDATA,R" -nxcompat:no -incremental:no \
    -fixed:no -dynamicbase:no -nodefaultlib -base:0xffffffff80000000 -entry:x64Entry

INCLUDE = ./lib/

OBJECTS = ./core/alloc.o \
./core/init.o \
./core/panic.o \
./core/thread.o \
./lib/ec/new.o \
./lib/ec/string.o \
./lib/libc/mem.o \
./lib/libc/print.o \
./lib/libc/str.o \
./hw/acpi/acpi.o \
./hw/cpu/cpu.o \
./hw/cpu/isr.o \
./hw/cpu/intctrl.o \
./hw/cpu/x64.o \
./hw/gfx/output.o \
./hw/ps2/keyboard.o \
./hw/ps2/ps2.o \
./hw/serial/serial.o \
./hw/timer/timer.o \

OBJS = $(addprefix $(BUILD)/,$(OBJECTS:./%=%))

# clang writes one compile_commands.json entry per C++ file (-MJ), merged by the top level makefile
JSONS = $(patsubst %.o,%.o.json,$(filter-out %cpu.o %isr.o,$(OBJS)))

OUT = ../bin/$(CONFIG)/vdisk/EFI/BOOT/kernel.exe

all: $(OUT)

# Link straight to the output path so make can tell when it is up to date
$(OUT): $(OBJS)
	mkdir -p $(dir $@)
	$(LD) $(LFLAGS) $^ -out:$@

# Header dependencies generated by -MMD
-include $(wildcard $(OBJS:.o=.d))

$(BUILD)/%.o: %.asm
	mkdir -p $(dir $@)
	$(AS) $(ASFLAGS) $< -o $@

$(BUILD)/%.o $(BUILD)/%.o.json: %.cc
	mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MJ $(BUILD)/$*.o.json -c $< -o $(BUILD)/$*.o

compdb: $(JSONS)

.SILENT:
.PHONY: all clean compdb
clean:
	rm -rf build
	find -type f \( -name "*.o" -o -name "*.d" -o -name "*.exe" \) -delete
